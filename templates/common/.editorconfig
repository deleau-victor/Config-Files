root = true

##################################################
################ GENERAL SETTINGS ################
##################################################
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,markdown}]
indent_size = 2
# Deux espaces en fin de ligne : saut de ligne en Markdown
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

